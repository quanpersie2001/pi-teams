{
	"name": "@quandev104/pi-teams",
	"version": "0.1.2",
	"description": "Specialist team runtime extension for Pi: independent-process teammates, agent definitions, run lifecycle, backends, steer/stop/resume and inline UI.",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/quanpersie2001/pi-teams.git"
	},
	"homepage": "https://github.com/quanpersie2001/pi-teams#readme",
	"bugs": {
		"url": "https://github.com/quanpersie2001/pi-teams/issues"
	},
	"keywords": [
		"pi-package",
		"pi",
		"pi-coding-agent",
		"extension",
		"agent-teams",
		"agent-runtime"
	],
	"pi": {
		"extensions": [
			"./extension-src/pi-teams/pi/index.ts"
		],
		"skills": [
			"./skills"
		]
	},
	"files": [
		"dist",
		"docs",
		"README.md",
		"CHANGELOG.md",
		"LICENSE",
		"extension-src",
		"skills"
	],
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"depcruise": "depcruise extension-src/pi-teams --config dependency-cruiser.config.cjs",
		"test": "npm run build && vitest run",
		"test:watch": "npm run build && vitest",
		"build": "tsup",
		"package:smoke": "node --input-type=module -e \"await import('./dist/extensions/pi-teams.js'); await import('./dist/extensions/child-bridge.js'); await import('./dist/extensions/terminal-client.js'); const { access } = await import('node:fs/promises'); await access('./dist/extensions/headless-child.js'); console.log('package smoke: parent, bridge and terminal client load; execution entry packaged');\"",
		"dev": "tsup --watch",
		"dev:pi": "node ./node_modules/@earendil-works/pi-coding-agent/dist/bundle/cli.js -ne -e .",
		"smoke:live": "node ./node_modules/@earendil-works/pi-coding-agent/dist/bundle/cli.js -ne -e . -p \"Reply with exactly: OK\"",
		"check": "npm run typecheck && npm run lint && npm run depcruise && npm run test && npm run package:smoke"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": "*",
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-agent-core": ">=1.0.4 <1.1.0",
		"@earendil-works/pi-ai": ">=1.0.4 <1.1.0",
		"@earendil-works/pi-coding-agent": ">=1.0.4 <1.1.0",
		"@earendil-works/pi-tui": ">=1.0.4 <1.1.0",
		"typebox": ">=1.3.27 <2.0.0",
		"@biomejs/biome": "^2.5.0",
		"@types/node": "^24.0.0",
		"dependency-cruiser": "^17.4.3",
		"git-cliff": "2.13.1",
		"tsup": "^8.5.0",
		"typescript": "^5.8.3",
		"vitest": "^4.1.8"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
